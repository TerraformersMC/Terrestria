{
  "schemaVersion": 1,
  "id": "terrestria",
  "version": "${version}",
  "name": "Terrestria",
  "description": "A mod enhancing the detail of Minecraft with unique and vibrant biomes. Inspired by ExtrabiomesXL.",
  "authors": [
    "coderbot16",
    "NeusFear",
    "TerraformersMC"
  ],
  "contributors": [
    "Valoeghese",
    "SuperCoder79",
    "Prospector",
    "NebelNidas",
    "haykam821",
    "Trinsdar",
    "gniftygnome",
    "magneticflux-",
    "alicia",
    "Fred"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/terrestria",
    "sources": "https://github.com/TerraformersMC/Terrestria",
    "issues": "https://github.com/TerraformersMC/Terrestria/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/terrestria/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.terraformersmc.terrestria.TerrestriaClient"
    ],
    "main": [
      "com.terraformersmc.terrestria.Terrestria"
    ],
    "terraform-biome-remapper": [
      "com.terraformersmc.terrestria.init.helpers.TerrestriaBiomeRemappings"
    ],
    "terraform-boat-dfu": [
      "com.terraformersmc.terrestria.init.helpers.TerrestriaBoatDfu"
    ],
    "terraform-leaves-dfu": [
      "com.terraformersmc.terrestria.init.helpers.TerrestriaLeavesDfu"
    ],
    "fabric-datagen": [
      "com.terraformersmc.terrestria.data.TerrestriaDatagen"
    ]
  },
  "accessWidener": "terrestria.accesswidener",
  "mixins": [
    "mixins.terrestria-common.json",
    "mixins.terrestria-common.pathing.json"
  ],
  "custom": {
    "extrapieces:piecepack": "extrapieces.terrestria.json"
  },
  "depends": {
    "biolith": ">=3.2.0-",
    "fabricloader": ">=0.18.0",
    "fabric-api": ">=0.144.0",
    "minecraft": ">=26.1 <26.2",
    "java": ">=25"
  }
}
